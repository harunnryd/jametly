{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "jametly",
  "version": "0.0.0",
  "identifier": "app.jametly.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "jametly",
        "width": 600,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "appimage", "deb", "nsis"],
    "category": "Productivity",
    "shortDescription": "Local, invisible AI that listens with you during meetings",
    "longDescription": "jametly runs a local AI that captures meeting audio and surfaces answers, summaries, and follow-ups in a hotkey overlay. 100% on-device, 100% invisible, 100% yours.",
    "copyright": "© 2026 jametly contributors",
    "externalBin": [],
    "publisher": "jametly",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": "https://github.com/jametly/jametly/releases/latest/download/latest.json",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
